# =============================================================
# Database
# =============================================================
# Pooled connection (PgBouncer). Used at runtime.
DATABASE_URL="postgresql://user:pass@host:5432/db?pgbouncer=true&connection_limit=1"
# Direct (non-pooled) connection. Required by Prisma for migrations.
DIRECT_URL="postgresql://user:pass@host:5432/db"

# =============================================================
# better-auth
# =============================================================
# 32+ char random string. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=iHH2gmnNzfr0Ecg8YI0gJVXs0nkf6UHN
# Canonical app origin. Must match the deployed URL exactly.
BETTER_AUTH_URL="http://localhost:3000"
# Exposed to the auth client (lib/auth-client.ts). Same value as BETTER_AUTH_URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional per-deployment pepper mixed into Driver PIN hashes
# (SHA-256 of pin + pepper). Schema enforces @unique on driverPinHash.
# Leaving empty is fine in dev; set in production to defeat rainbow-table
# attacks even if the DB is exfiltrated.
DRIVER_PIN_PEPPER=""

# Vercel cron auth (required only if you configure VERCEL_CRON in production).
# Vercel sends `Authorization: Bearer <CRON_SECRET>` on cron-triggered hits.
CRON_SECRET=""

# =============================================================
# Stripe
# =============================================================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
