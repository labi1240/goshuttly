// Shuttle Service - Prisma Schema (Canada) - v3
//
// v3 changes over v2:
//  - UUIDs everywhere (marketplace-safe, no enumeration, client-generatable)
//  - Multi-leg trip model: ScheduleTemplate -> LegTemplate -> Trip -> TripLeg
//    Bookings claim per-leg seats (BookingLeg) so intermediate stops sell.
//  - Shift model separates Driver+Vehicle assignment from Trip lifecycle.
//  - LocationPing time-series telemetry with documented retention.
//  - StripeWebhookEvent idempotency log.
//  - Refund split into its own table; supports multiple partial refunds and
//    tracks whether operator share was clawed back (reversedTransfer).
//  - Per-operator refund policy fields on ShuttleCompany.
//  - NotificationLog, DeviceToken, ApiKey operational tables.
//  - taxJurisdiction captured per booking for CRA audit defensibility.
//  - Multiple Operators (managers) per ShuttleCompany (v2 bug fix).
//  - Kept from v2: ComplianceDocument, Verification flow, Reviews, TicketTier.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// AUTH & USERS
// ============================================================

model User {
  // better-auth requires the PK to be exposed to its Prisma client as `id`.
  // We keep the DB column named "uid" so no SQL migration is needed and so
  // existing rows continue to satisfy FKs from Passenger/Operator/Driver/etc.
  id        String   @id @default(uuid()) @map("uid")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String?
  image       String?
  phoneNumber String?

  Credentials   Credentials?
  AuthProvider  AuthProvider?
  Admin         Admin?
  Operator      Operator?
  Driver        Driver?
  Passenger     Passenger?
  DeviceTokens  DeviceToken[]
  email         String
  emailVerified Boolean       @default(false)
  sessions      Session[]
  accounts      Account[]

  // better-auth organization plugin
  Memberships       Member[]
  SentInvitations   Invitation[] @relation("InvitationInviter")

  @@unique([email])
}

model Credentials {
  uid          String   @id
  User         User     @relation(fields: [uid], references: [id])
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuthProvider {
  uid        String           @id
  type       AuthProviderType
  externalId String? // Clerk/Auth0/Google subject if applicable
  User       User             @relation(fields: [uid], references: [id])

  @@unique([type, externalId])
}

enum AuthProviderType {
  GOOGLE
  APPLE
  CLERK
  CREDENTIALS
}

// ============================================================
// ROLES
// ============================================================

model Admin {
  uid       String   @id
  User      User     @relation(fields: [uid], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  CompanyVerifications CompanyVerification[]
  DriverVerifications  DriverVerification[]
  VehicleVerifications VehicleVerification[]
  ComplianceReviews    ComplianceDocument[]
}

model Passenger {
  uid       String   @id
  User      User     @relation(fields: [uid], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  displayName           String?
  emergencyContactName  String?
  emergencyContactPhone String?

  Bookings Booking[]
  Reviews  Review[]
}

// A human manager/dispatcher inside a ShuttleCompany. Multiple per company.

model Operator {
  uid       String   @id
  User      User     @relation(fields: [uid], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  displayName String?
  role        OperatorRole @default(MANAGER)

  companyId       String?
  Company         ShuttleCompany?   @relation(fields: [companyId], references: [id])
  BookingTimeline BookingTimeline[]

  // 1:1 link to better-auth's Member row. Nullable for backfill of existing
  // Operators created before the org plugin landed. App layer keeps
  // Operator.role and Member.role in sync; Operator.role is authoritative
  // for business logic, Member.role drives better-auth permission checks.
  memberId String? @unique
  Member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

enum OperatorRole {
  OWNER // can manage billing, add other managers
  MANAGER // can manage routes/vehicles/drivers/schedules
  DISPATCHER // day-of-ops: assign shifts, handle disruptions
  FINANCE // read-only access to payments/payouts
}

model Driver {
  uid       String   @id
  User      User     @relation(fields: [uid], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  displayName String
  image       String?

  // PIN-based login for in-vehicle tablet. Hashed in code; never plaintext.
  driverPinHash String? @unique

  // Provincial licensing
  licenceNumber   String       @default("")
  licenceClass    LicenceClass @default(CLASS_4)
  licenceProvince Province?
  licenceExpiry   DateTime?

  companyId String
  Company   ShuttleCompany @relation(fields: [companyId], references: [id])

  Shifts              Shift[]
  Boardings           BookingLeg[]         @relation("BoardedByDriver")
  BookingTimeline     BookingTimeline[]
  Verification        DriverVerification?
  ComplianceDocuments ComplianceDocument[]
  DeviceTokens        DeviceToken[]

  @@unique([companyId, uid])
  @@index([companyId])
}

// ============================================================
// COMPANY (Shuttle Operator)
// ============================================================

model ShuttleCompany {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  displayName String
  description String?

  // Canadian business identifiers
  legalName      String?
  businessNumber String? @unique // CRA Business Number
  gstHstNumber   String?

  // Stripe Connect (Express)
  stripeAccountId          String?           @unique
  stripeAccountType        StripeAccountType @default(EXPRESS)
  stripeOnboardingComplete Boolean           @default(false)
  stripeChargesEnabled     Boolean           @default(false)
  stripePayoutsEnabled     Boolean           @default(false)
  stripeRequirementsDue    Json?
  stripeOnboardedAt        DateTime?

  // Per-company commission (basis points). 500 = 5.00%.
  platformFeeBps Int @default(500)

  // Tiered cancellation policy (hours before departure).
  //   t > refundFullHoursBefore                            -> 100% refund
  //   refundPartialHoursBefore < t < refundFullHoursBefore -> refundPartialPercent
  //   t < refundPartialHoursBefore                         -> no refund
  refundFullHoursBefore    Int @default(24)
  refundPartialHoursBefore Int @default(2)
  refundPartialPercent     Int @default(50)

  active Boolean @default(true)

  // 1:1 link to better-auth's Organization row. Nullable for backfill of
  // companies created before the org plugin landed. SetNull (not Cascade)
  // because ShuttleCompany has CRA-retained financial records that must
  // outlive any auth-side org deletion.
  organizationId String?       @unique
  Organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  HeadOfficeAddress   Address?
  Operators           Operator[]
  Drivers             Driver[]
  Vehicles            Vehicle[]
  Routes              Route[]
  Reviews             Review[]
  Verification        CompanyVerification?
  ComplianceDocuments ComplianceDocument[]
  Payouts             Payout[]
  Payments            Payment[]
  ApiKeys             ApiKey[]
}

enum StripeAccountType {
  EXPRESS
  STANDARD
  CUSTOM
}

model Address {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  address    String
  city       String
  province   Province
  postalCode String
  country    String   @default("CA")
  lat        Float?
  lng        Float?

  companyId String         @unique
  Company   ShuttleCompany @relation(fields: [companyId], references: [id])
}

// ============================================================
// VEHICLES
// ============================================================

model Vehicle {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  code         String      @unique // human-readable, e.g. "VAN-001"
  make         String
  modelName    String
  year         Int
  colour       String?
  plateNumber  String      @unique
  vin          String?     @unique
  seatCapacity Int         @default(25)
  type         VehicleType @default(SHUTTLE_VAN)
  images       String[]

  status            VehicleStatus @default(ACTIVE)
  outOfServiceNote  String?
  outOfServiceUntil DateTime?

  insuranceExpiry  DateTime?
  inspectionExpiry DateTime?

  companyId String
  Company   ShuttleCompany @relation(fields: [companyId], references: [id])

  Shifts              Shift[]
  Verification        VehicleVerification?
  ComplianceDocuments ComplianceDocument[]

  @@index([companyId, status])
}

enum VehicleType {
  SHUTTLE_VAN
  MINI_BUS
  COACH_BUS
  SUV
  SEDAN
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  OUT_OF_SERVICE
  RETIRED
}

// ============================================================
// COMPLIANCE
// ============================================================

model ComplianceDocument {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type           ComplianceType
  issuer         String
  documentNumber String?
  fileUrl        String?
  issuedAt       DateTime?
  expiresAt      DateTime?

  verified        Boolean @default(false)
  rejectionReason String?
  reviewedById    String?
  ReviewedBy      Admin?  @relation(fields: [reviewedById], references: [uid])

  companyId String?
  Company   ShuttleCompany? @relation(fields: [companyId], references: [id])

  driverId String?
  Driver   Driver? @relation(fields: [driverId], references: [uid])

  vehicleId String?
  Vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([companyId, type])
  @@index([driverId, type])
  @@index([vehicleId, type])
  @@index([expiresAt])
}

enum ComplianceType {
  PTC_LICENCE
  MUNICIPAL_LIVERY_PERMIT
  AIRPORT_AUTHORITY_PERMIT
  PROVINCIAL_OPERATING_LICENCE
  VEHICLE_INSURANCE
  VEHICLE_INSPECTION
  COMMERCIAL_VEHICLE_PERMIT
  DRIVER_ABSTRACT
  DRIVER_BACKGROUND_CHECK
  DRIVER_MEDICAL
  WSIB_CLEARANCE
  GST_HST_REGISTRATION
  OTHER
}

// ============================================================
// ROUTES, STOPS, SCHEDULES (TEMPLATES)
// ============================================================

// A Route is a named travel product owned by a company.
// Example: "Toronto -> Niagara Falls Express"

model Route {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  displayName String
  description String?
  isPremium   Boolean @default(false)
  active      Boolean @default(true)

  companyId         String
  Company           ShuttleCompany     @relation(fields: [companyId], references: [id])
  ScheduleTemplates ScheduleTemplate[]

  @@index([companyId])
}

// A passenger-facing pickup/dropoff location. Reusable across routes.

model Stop {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  code       String   @unique // e.g. "TOR-UNION", "YYZ-T1"
  name       String
  address    String
  city       String
  province   Province
  postalCode String?
  country    String   @default("CA")
  lat        Float
  lng        Float
  timezone   String   @default("America/Toronto") // IANA

  legsFromHere LegTemplate[] @relation("LegTemplateFromStop")
  legsToHere   LegTemplate[] @relation("LegTemplateToStop")
}

// A ScheduleTemplate is a recurring departure pattern for a Route.
// Example: "Morning Express - daily 07:00 Toronto departure"

model ScheduleTemplate {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  label       String
  sortOrder   Int       @default(0)
  activeFrom  DateTime  @default(now())
  activeUntil DateTime?

  // Days of week this template runs on (0=Sunday..6=Saturday). Empty = daily.
  daysOfWeek Int[] @default([])

  routeId String
  Route   Route  @relation(fields: [routeId], references: [id])

  LegTemplates LegTemplate[]
  Trips        Trip[]

  @@index([routeId, sortOrder])
  @@index([activeFrom, activeUntil])
}

// A leg of a schedule template: an ordered segment between two stops.
// departMin / arriveMin are minutes from midnight in the FROM stop's local
// timezone. This keeps templates DST-safe; concrete datetimes are computed
// when Trip rows are generated for a serviceDate.

model LegTemplate {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  templateId String
  Template   ScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  sequence  Int // 0,1,2... travel order within the template
  departMin Int // minutes from midnight at fromStop
  arriveMin Int // minutes from midnight at toStop (may cross midnight)
  bookable  Boolean @default(true) // false = deadhead/relocation leg

  priceCents Int // CAD cents for this individual segment

  fromStopId String
  FromStop   Stop   @relation("LegTemplateFromStop", fields: [fromStopId], references: [id])

  toStopId String
  ToStop   Stop   @relation("LegTemplateToStop", fields: [toStopId], references: [id])

  TripLegs TripLeg[]

  @@unique([templateId, sequence])
  @@index([fromStopId])
  @@index([toStopId])
}

// ============================================================
// TRIPS & LEGS (INSTANCES)
// ============================================================

// A Trip is an instance of a ScheduleTemplate on a specific service date.
// All TripLegs for a Trip are generated together from the LegTemplates.

model Trip {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceDate DateTime   @db.Date
  status      TripStatus @default(SCHEDULED)
  notes       String?

  templateId String
  Template   ScheduleTemplate @relation(fields: [templateId], references: [id])

  TripLegs TripLeg[]
  Shifts   Shift[]
  Reviews  Review[]

  @@unique([templateId, serviceDate])
  @@index([serviceDate])
  @@index([status])
}

enum TripStatus {
  SCHEDULED
  BOARDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

// A concrete leg on a concrete trip with real datetimes and seat counters.
// seatsTotal is snapshotted from the Vehicle assigned via Shift; if vehicle
// changes mid-cycle, callers must reconcile.
//
// CONCURRENCY DISCIPLINE — read before touching the booking service:
//
// Standard `prisma.tripLeg.update({ data: { seatsBooked: { increment: 1 } } })`
// does NOT serialize concurrent bookings. On a busy Friday afternoon route,
// two checkouts for the last seat will both succeed and you'll oversell.
//
// Required pattern inside the booking transaction:
//
//   await tx.$executeRaw`
//     SELECT id FROM "TripLeg"
//     WHERE id IN (${Prisma.join(legIds)})
//     ORDER BY "departAt" ASC
//     FOR UPDATE
//   `;
//   // ... then verify seatsBooked + requested <= seatsTotal for each leg
//   // ... then perform the increments via standard Prisma update
//
// The ORDER BY is mandatory — without a deterministic lock order, two
// bookings on overlapping leg ranges (A->C and B->D) will deadlock.

model TripLeg {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tripId String
  Trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  legTemplateId String
  LegTemplate   LegTemplate @relation(fields: [legTemplateId], references: [id])

  departAt DateTime // UTC; render in fromStop.timezone
  arriveAt DateTime // UTC

  seatsTotal  Int @default(25)
  seatsBooked Int @default(0)

  // Which Shift is responsible for staffing this leg. Multiple legs on
  // the same trip can point to different Shifts (driver swap, breakdown).
  shiftId String?
  Shift   Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  BookingLegs BookingLeg[]

  @@unique([tripId, legTemplateId])
  @@index([departAt])
  @@index([shiftId])
}

// ============================================================
// SHIFTS (driver+vehicle assigned to a Trip)
// ============================================================

// A Shift binds a Driver+Vehicle to a contiguous range of legs on a Trip.
// Most trips have exactly one Shift covering all legs. Long-haul routes
// (e.g. Toronto-Ottawa) and mid-route disruptions (driver swap at a rest
// stop, vehicle breakdown) require multiple Shifts per Trip -- each TripLeg
// points to the Shift currently responsible via TripLeg.shiftId.
//
// Invariant: every TripLeg.shiftId where set must reference a Shift whose
// tripId matches the leg's parent Trip. Enforced at application layer.

model Shift {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status    ShiftStatus @default(SCHEDULED)
  startedAt DateTime?
  endedAt   DateTime?

  // Latest known position; time-series in LocationPing.
  lat Float?
  lng Float?

  tripId String // NOT unique: a Trip may have multiple Shifts (driver swaps, breakdowns)
  Trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  vehicleId String
  Vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  driverId String
  Driver   Driver @relation(fields: [driverId], references: [uid])

  TripLegs      TripLeg[]
  LocationPings LocationPing[]

  @@index([tripId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([status])
}

enum ShiftStatus {
  SCHEDULED
  EN_ROUTE
  COMPLETED
  CANCELLED
}

// Time-series GPS telemetry for a Shift.
// RETENTION: high write volume. Plan to drop or cold-store pings > 90 days.

model LocationPing {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  recordedAt DateTime

  lat      Float
  lng      Float
  speedKph Float?
  heading  Float?

  shiftId String
  Shift   Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId, recordedAt])
}

// ============================================================
// BOOKINGS
// ============================================================

// A Booking is one passenger transaction. It may span multiple legs of a
// single trip (e.g. Toronto -> Mississauga -> Niagara on the same trip).
// Currently scoped to a single trip; cross-trip itineraries would need a
// parent Itinerary entity.

model Booking {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reference String @unique // human-readable, e.g. "SHTL-A4F2K9"

  // Either a registered passenger OR guest checkout
  passengerId    String?
  Passenger      Passenger? @relation(fields: [passengerId], references: [uid])
  guestEmail     String?
  guestFirstName String?
  guestLastName  String?
  guestPhone     String?

  seatsBooked Int @default(1) // sum of seats across all BookingLegs

  // Money (cents)
  subtotalCents   Int
  bookingFeeCents Int    @default(0) // passenger-paid platform/processing fee
  gstCents        Int    @default(0)
  hstCents        Int    @default(0)
  pstCents        Int    @default(0)
  qstCents        Int    @default(0)
  totalCents      Int
  currency        String @default("CAD")

  // Which provincial tax regime was applied. Snapshot for audit.
  taxJurisdiction Province?

  tier TicketTier @default(STANDARD)

  status        BookingStatus @default(PENDING_PAYMENT)
  holdExpiresAt DateTime? // seat reservation expiry; reaper releases on timeout

  cancelledAt        DateTime?
  cancellationReason String?

  // Soft-delete marker. Bookings are NEVER hard-deleted (CRA 7-year rule).
  // After retention expires, set deletedAt and scrub PII (guestEmail,
  // guestPhone, guestFirstName, guestLastName, passcode) to null while
  // preserving the financial fields.
  deletedAt DateTime?

  // Indian Act s.87 exemption: status-card holders are tax-exempt on
  // services delivered on reserve (rules vary by province and whether
  // the route touches reserve land). Snapshot at booking time; the
  // reference number is stored for CRA audit defense.
  taxExempt       Boolean @default(false)
  taxExemptionRef String?

  passcode String? // boarding QR token

  BookingLegs     BookingLeg[]
  Payment         Payment?
  BookingTimeline BookingTimeline[]
  Notifications   NotificationLog[]
  AccessTokens    BookingAccessToken[]

  @@index([status, holdExpiresAt])
  @@index([passengerId])
  @@index([guestEmail])
  @@index([guestPhone])
  @@index([deletedAt])
}

enum BookingStatus {
  PENDING_PAYMENT // seat held, awaiting payment
  CONFIRMED // paid
  BOARDED
  IN_TRANSIT
  COMPLETED
  CANCELLED
  REFUNDED
  EXPIRED // hold timed out before payment
  NO_SHOW
}

enum TicketTier {
  ECONOMY_FLEX_WINDOW
  STANDARD
  REFUNDABLE
  PREMIUM
}

// One row per leg the booking claims. Holds per-leg pricing and boarding state.

model BookingLeg {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  bookingId String
  // Restrict: BookingLegs are part of the ledger.
  Booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  tripLegId String
  TripLeg   TripLeg @relation(fields: [tripLegId], references: [id])

  passengers     Int @default(1)
  unitPriceCents Int

  boardedStatus     BoardedStatus @default(NOT_BOARDED)
  boardedAt         DateTime?
  boardedByDriverId String?
  BoardedByDriver   Driver?       @relation("BoardedByDriver", fields: [boardedByDriverId], references: [uid])

  @@unique([bookingId, tripLegId])
  @@index([tripLegId])
  @@index([boardedByDriverId])
}

enum BoardedStatus {
  NOT_BOARDED
  BOARDED
  NO_SHOW
}

model BookingTimeline {
  id        String        @id @default(uuid())
  timestamp DateTime      @default(now())
  status    BookingStatus
  note      String?

  bookingId String
  // Restrict: timeline is the audit log for the booking lifecycle.
  Booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  driverId String?
  Driver   Driver? @relation(fields: [driverId], references: [uid])

  operatorId String?
  Operator   Operator? @relation(fields: [operatorId], references: [uid])

  @@index([bookingId])
}

// ============================================================
// PAYMENTS, REFUNDS, PAYOUTS
// ============================================================

model Payment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  amountTotalCents    Int
  applicationFeeCents Int    @default(0) // platform's commission
  operatorNetCents    Int    @default(0) // operator's share after fees
  stripeFeeCents      Int? // populated from balance_transaction
  currency            String @default("CAD")

  provider PaymentProvider @default(STRIPE)
  method   PaymentMethod?
  status   PaymentStatus   @default(REQUIRES_PAYMENT)

  // Stripe identifiers
  stripeCheckoutSessionId  String? @unique
  stripePaymentIntentId    String? @unique
  stripeChargeId           String? @unique
  stripeCustomerId         String?
  stripeTransferId         String? @unique
  stripeDestinationAccount String? // operator's acct_xxx

  // Idempotency for retries and double-submit protection
  idempotencyKey String @unique

  bookingId String  @unique
  // Restrict (not Cascade): CRA requires 7-year retention of financial
  // records. Deleting a Booking with a Payment must throw, not silently
  // nuke the ledger. Use Booking.deletedAt for PII scrub after retention.
  Booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  companyId String?
  Company   ShuttleCompany? @relation(fields: [companyId], references: [id])

  Refunds Refund[]

  @@index([companyId])
  @@index([status])
}

enum PaymentProvider {
  STRIPE
  INTERAC
  PAYPAL
  CASH
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  INTERAC_ETRANSFER
  APPLE_PAY
  GOOGLE_PAY
  CASH
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

// Supports multiple partial refunds per Payment.
// reversedTransfer            = was operator's share clawed back?
// reversedAmountCents         = how much of operator's share came back
// reversedApplicationFeeCents = how much of platform's commission came back
// (passenger refund = reversedAmountCents + reversedApplicationFeeCents
//  on a full refund; partial refunds may split differently per business rule)

model Refund {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  stripeRefundId              String       @unique
  amountCents                 Int // total returned to passenger
  reason                      RefundReason
  notes                       String?
  reversedTransfer            Boolean      @default(false)
  reversedAmountCents         Int          @default(0) // clawed back from operator
  reversedApplicationFeeCents Int          @default(0) // returned from platform

  paymentId String
  // Restrict (not Cascade): refunds are part of the 7-year financial record.
  Payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
}

enum RefundReason {
  OPERATOR_CANCELLED
  PASSENGER_CANCELLED_FREE_WINDOW
  PASSENGER_CANCELLED_PARTIAL
  PASSENGER_CANCELLED_LATE
  SERVICE_FAILURE
  DUPLICATE_CHARGE
  FRAUD
  DISPUTE_LOST
  GOODWILL
}

model Payout {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stripePayoutId String       @unique
  amountCents    Int
  currency       String       @default("CAD")
  status         PayoutStatus @default(PENDING)
  arrivalDate    DateTime?
  failureReason  String?

  companyId String
  // Restrict: payouts are CRA-retained financial records; archive the
  // ShuttleCompany via active=false instead of hard-deleting.
  Company   ShuttleCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
}

enum PayoutStatus {
  PENDING
  IN_TRANSIT
  PAID
  FAILED
  CANCELED
}

// ============================================================
// STRIPE WEBHOOK IDEMPOTENCY
// ============================================================

// Every Stripe webhook event is logged here before processing. The unique
// constraint on stripeEventId is the idempotency guard -- Stripe retries on
// 5xx and we must not double-apply refunds, seat decrements, etc.

model StripeWebhookEvent {
  id              String    @id @default(uuid())
  stripeEventId   String    @unique
  eventType       String
  payload         Json
  processed       Boolean   @default(false)
  processingError String?
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  @@index([eventType])
  @@index([processed])
}

// ============================================================
// REVIEWS
// ============================================================

model Review {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rating  Int     @default(0)
  comment String?

  passengerId String
  Passenger   Passenger @relation(fields: [passengerId], references: [uid])

  tripId String?
  Trip   Trip?   @relation(fields: [tripId], references: [id])

  companyId String?
  Company   ShuttleCompany? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([tripId])
}

