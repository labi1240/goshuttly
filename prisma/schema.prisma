datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Operator {
  id           String    @id @default(uuid())
  businessName String
  email        String    @unique
  phone        String
  vehicles     Vehicle[]
  routes       Route[]
  drivers      Driver[]
  createdAt    DateTime  @default(now())
}

model Vehicle {
  id          String   @id @default(uuid())
  operatorId  String
  operator    Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  plateNumber String   @unique
  makeModel   String
  capacity    Int
  shifts      Shift[]
}

model Driver {
  id         String   @id @default(uuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  driverPin  String   @unique
  name       String
  phone      String
  shifts     Shift[]
}

model Route {
  id          String   @id @default(uuid())
  operatorId  String
  operator    Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  origin      String
  destination String
  basePrice   Float
  trips       Trip[]
}

model Trip {
  id            String  @id @default(uuid())
  routeId       String
  route         Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  departureTime String
  arrivalTime   String
  shifts        Shift[]
}

model Shift {
  id        String    @id @default(uuid())
  vehicleId String
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])
  driverId  String
  driver    Driver    @relation(fields: [driverId], references: [id])
  tripId    String
  trip      Trip      @relation(fields: [tripId], references: [id])
  date      DateTime
  lat       Float?
  lng       Float?
  status    String    @default("SCHEDULED")
  bookings  Booking[]
  updatedAt DateTime  @updatedAt

  @@index([date, tripId])
  @@index([status])
}

model Booking {
  id             String   @id @default(uuid())
  shiftId        String
  shift          Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  passengerName  String
  passengerEmail String
  passengerPhone String
  seatCount      Int
  qrCodeToken    String   @unique
  paymentStatus  String   @default("PENDING")
  boardedStatus  String   @default("NOT_BOARDED")
  createdAt      DateTime @default(now())

  @@index([shiftId])
  @@index([qrCodeToken])
}
