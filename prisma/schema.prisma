// ============================================================
// OPERATIONAL TABLES
// ============================================================

// Push notification device tokens. Tokens are ephemeral (revoked, sold,
// logged-out devices). Treat as transient bindings, not user attributes.
// Exactly one of userId/driverId set; enforced at application layer.

model DeviceToken {
  id         String         @id @default(uuid())
  token      String         @unique
  platform   DevicePlatform
  appVersion String?
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  userId String?
  User   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  driverId String?
  Driver   Driver? @relation(fields: [driverId], references: [uid], onDelete: Cascade)

  @@index([userId])
  @@index([driverId])
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

// Outbound notification audit log. "I never got my receipt" -> check this.

model NotificationLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  channel           NotificationChannel
  template          String
  recipient         String // email or E.164 phone
  status            NotificationStatus  @default(QUEUED)
  providerMessageId String?
  error             String?
  sentAt            DateTime?
  deliveredAt       DateTime?

  bookingId String?
  Booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([status])
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

// Server-to-server API keys for operator integrations (their own dispatch
// system, GDS connectors, etc.). Store keyHash only. prefix is the first
// ~8 visible chars for UX (so operators can identify a key without revealing it).

model ApiKey {
  id         String    @id @default(uuid())
  createdAt  DateTime  @default(now())
  keyHash    String    @unique
  prefix     String
  name       String
  scopes     String[]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  companyId String?
  Company   ShuttleCompany? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// Magic-link access tokens for guest checkout. Issued at booking confirmation
// and emailed/SMS'd to the guest, e.g. https://app.com/b/{plaintext-token}.
// The token's plaintext is shown to the user ONCE in the delivered URL; only
// the hash is stored here. Lookup by hash, validate not expired/revoked, then
// render the booking page where the QR-encoded Booking.passcode is displayed.
//
// Distinct from Booking.passcode:
//   - passcode    = short credential the DRIVER scans (validated at boarding)
//   - this token  = long credential the GUEST uses to authenticate to the page

model BookingAccessToken {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  tokenHash String             @unique // SHA-256 of the plaintext token
  purpose   AccessTokenPurpose @default(GUEST_VIEW)

  expiresAt  DateTime // e.g. trip end + 30d grace
  revokedAt  DateTime?
  lastUsedAt DateTime?
  useCount   Int       @default(0)

  // Optional binding to a single channel (for analytics/abuse triage)
  sentToEmail String?
  sentToPhone String?

  bookingId String
  Booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([expiresAt])
}

enum AccessTokenPurpose {
  GUEST_VIEW // primary: view booking + boarding QR
  REFUND_CONFIRM // one-time link to confirm a cancellation
  SMS_RESEND // ops-issued, short-lived resend link
  DRIVER_OVERRIDE // dispatcher-issued, allows boarding without QR
}

